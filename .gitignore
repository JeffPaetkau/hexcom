# Per-machine tool settings (absolute paths, local permission grants, the usage-feed token)
.claude/settings.local.json

# Worktrees created inside the repo by EnterWorktree
.claude/worktrees/

# Raw captures of other games, dropped here by the user; evidence, not source
reference-inbox/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Godot and .NET build output
game/.godot/
**/bin/
**/obj/

# local Codex config (holds the usage-meter token)
.codex/

# The Morgan showcase model: regenerated by art/characters/sgt_morgan/scripts/export_godot.py
game/characters/morgan/*.glb
game/characters/morgan/*.glb.import
game/characters/morgan/*.png
game/characters/morgan/*.png.import
game/characters/morgan/*.jpg
game/characters/morgan/*.jpg.import
game/characters/morgan/morgan_motion.json
