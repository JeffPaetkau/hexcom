{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sgt_morgan/scripts/eval/critic/schema.json",
  "title": "A critic's result for one packet (spec 18 §8.1.4, plus the ranked list)",
  "description": "Validated by tally.py's own small validator, which knows only the keywords used here, so the cloud and the workstation agree without the jsonschema package. Unknown keys are refused so that a misspelt optional key is caught rather than silently lost.",
  "type": "object",
  "required": ["part", "round", "critic", "lens", "model", "packet_sha", "questions", "overall", "defects", "ranked", "pass"],
  "additionalProperties": false,
  "properties": {
    "part": {"type": "string", "pattern": "^(0[1-9]|1[0-8])$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "critic": {"enum": ["C1", "C2", "C3"]},
    "lens": {"enum": ["fidelity", "reality", "craft"]},
    "model": {"type": "string"},
    "packet_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "questions": {"type": "array", "items": {"type": "object", "required": ["id", "score", "note"],
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "score": {"type": "integer", "minimum": 1, "maximum": 10},
                     "note": {"type": "string", "maxLength": 400}}}},
    "overall": {"type": "integer", "minimum": 1, "maximum": 10},
    "defects": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "preset", "box_px", "what"],
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "severity": {"enum": ["blocking", "major", "minor"]},
                     "preset": {"type": "string", "description": "the packet image's file name"},
                     "box_px": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
                     "what": {"type": "string", "maxLength": 300}, "fix": {"type": "string", "maxLength": 300},
                     "spec_ref": {"type": "string"}}}},
    "ranked": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 300},
      "description": "What reads wrong, most important first, in free form: the most useful part of Jeff's two hand reviews of 2026-10-10. An item that is one of the critic's defects starts with its id in brackets, '[D3] ...'."},
    "verified_claims": {"type": "array", "items": {"type": "object", "required": ["id", "fixed"],
      "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "fixed": {"type": "boolean"}}}},
    "pass": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
