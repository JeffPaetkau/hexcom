!assets/README.md
renders/*
!renders/eval/
renders/eval/*
!renders/eval/*.png
*.blend1
*.blend2
__pycache__/
*.pyc
.venv/

# per-part .blend caches and other rebuildable intermediates (spec 17, spec 18)
cache/
