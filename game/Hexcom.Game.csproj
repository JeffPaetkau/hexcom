<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>Hexcom.Game</RootNamespace>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      One-way dependency: the view knows about the rules, the rules know nothing about Godot.
      Keep it that way. If this reference ever needs to point the other direction, something
      has leaked into the wrong assembly.
    -->
    <ProjectReference Include="..\src\Hexcom.Core\Hexcom.Core.csproj" />
    <!--
      Maps come from content, embedded in that assembly, so the sandbox can ask for one by name
      without knowing where the repository is on disk. Content is plain .NET for the same reason
      the core is: a map has to load in a headless test exactly as it loads in a scene.
    -->
    <ProjectReference Include="..\content\Hexcom.Content\Hexcom.Content.csproj" />
  </ItemGroup>

</Project>
